# ============================================================
# Variables d'environnement — Carrosserie Lomrye
# Copier ce fichier en `.env.local` et compléter les valeurs.
# ============================================================

# --- Envoi des demandes de devis (https://resend.com) ---
# Sans ces deux variables, le formulaire affiche un message honnête
# invitant à appeler le garage (aucun faux envoi simulé).
RESEND_API_KEY=
QUOTE_TO_EMAIL=

# Expéditeur vérifié chez Resend (optionnel ; défaut : onboarding@resend.dev, mode test)
QUOTE_FROM_EMAIL=

# --- URL canonique du site en production ---
NEXT_PUBLIC_SITE_URL=https://www.exemple.fr
